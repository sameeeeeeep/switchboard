+      base,
+      intent && "== INTENT (the goal) ==\n" + intent,
+      state && "== STATE (what exists now) ==\n" + state,
+      "Ground every draft in the gap between INTENT and STATE. Never invent a metric, customer, or result.",
+    ].filter(Boolean).join("\n\n");
   }
