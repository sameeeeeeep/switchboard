node_modules/
dist/
*.tsbuildinfo
.DS_Store
.env
.env.*
# Sidekick runtime state (secrets, tokens, grants, audit log) — never commit.
.relay/
*.log

# Voice samples + cloned voices + model weights (Pocket TTS / whisper) — user voice data
# and large binaries live in ~/.relay, never the repo. Belt-and-suspenders so a stray drop can't
# be committed (the god harness uses .png fixtures, not audio, so these are safe to ignore repo-wide).
*.safetensors
*.wav
*.mp3
*.m4a
*.aiff
*.ggml
*.bin

# menu-bar app build output
packages/menubar/build/
packages/menubar/Relay.app/

# Flow app build output (compiled .app + notarized DMG — never commit)
examples/flow/mac/build/
examples/flow/mac/Flow.app/

# brandbrain port build artifacts
examples/brandbrain-port/.build/
examples/brandbrain-port/dist/

# extension release zips — ship via GitHub Releases, not the tree
switchboard-*.zip

# Browser-pane / dev-server launch configs — developer-local, not shared
**/.claude/launch.json

# wrapp runtime state dumped during local dev/testing — not source
batch-state.json
